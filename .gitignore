# Obsidian: commit the vault config, not per-device UI state.
# The vault is content/. A root-level .obsidian means the repo root was opened by mistake.
/.obsidian/
content/.obsidian/workspace*.json
content/.obsidian/cache
content/.obsidian/plugins/*/data.json
content/.trash/

# Never push private material to a (public) repo.
# These folders are also excluded from the Quartz build (see quartz.config.ts).
content/_private/*
!content/_private/README.md
content/_inbox/*
!content/_inbox/README.md

# Private bibliography imports (course material) — never pushed
bibliography/import/
